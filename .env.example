# ===========================================
# Question Translation Service Configuration
# ===========================================

# DeepL API Configuration
# Get your API key from: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_TIMEOUT=30
DEEPL_MAX_RETRIES=3

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Authentication
# Set this to enable API key authentication
# Leave empty to disable authentication (not recommended for production)
API_KEY=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Limits
MAX_FILE_SIZE_MB=10
MAX_LANGUAGES_PER_BATCH=20

# Logging
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT: json (for production) or text (for development)
LOG_LEVEL=INFO
LOG_FORMAT=json
